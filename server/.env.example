# ==============================================================================
# TRIAUREX Backend & AI Chatbot Environment Configuration
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# AI Provider Configuration
# Supported providers: nvidia, gemini, openai, groq, openrouter
AI_PROVIDER=nvidia

# Your AI API Key (Keep secret! NEVER expose to client)
# NVIDIA NIM: https://build.nvidia.com
# Gemini: https://aistudio.google.com
# OpenAI: https://platform.openai.com
# Groq: https://console.groq.com
AI_API_KEY=your_ai_api_key_here

# AI Model Name
# Examples:
# NVIDIA: meta/llama-3.2-11b-vision-instruct
# Gemini: gemini-1.5-flash or gemini-2.0-flash
# OpenAI: gpt-4o-mini
# Groq: llama-3.3-70b-versatile
AI_MODEL=meta/llama-3.2-11b-vision-instruct

# Base URL for API endpoints
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://integrate.api.nvidia.com/v1
